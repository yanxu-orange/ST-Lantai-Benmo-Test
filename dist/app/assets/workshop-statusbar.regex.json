  "findRegex": "/<scene>[ \\t]*\\r?\\n[ \\t]*第([^章\\r\\n]+)章[ \\t]*[·•・][ \\t]*([^\\r\\n]+?)[ \\t]*\\r?\\n[ \\t]*([^\\r\\n]+?)[ \\t]*\\r?\\n[ \\t]*([^\\r\\n]+?)[ \\t]*\\r?\\n[ \\t]*([^\\r\\n]+?)[ \\t]*\\r?\\n?[ \\t]*<\\/scene>/g",
  "trimStrings": [],
  "replaceString": "<div class=\"yx-storybar lantai-storybar\" data-lantai-storybar=\"\" data-theme=\"day\">\n<style>\n.yx-storybar{\n  --yx-bg:#fbfaf7;\n  --yx-ink:#201f1c;\n  --yx-muted:#777168;\n  --yx-line:rgba(32,31,28,.16);\n  --yx-shadow:rgba(35,31,24,.08);\n\n  position:relative;\n  overflow:hidden;\n  margin:12px 4px 18px;\n  padding:20px 20px 16px;\n  background:var(--yx-bg);\n  color:var(--yx-ink);\n  border:1px solid var(--yx-line);\n  border-radius:3px;\n  box-shadow:0 8px 24px var(--yx-shadow);\n  transition:\n    background .22s ease,\n    color .22s ease,\n    border-color .22s ease,\n    box-shadow .22s ease;\n}\n\n.yx-storybar[data-theme=\"night\"]{\n  --yx-bg:#202226;\n  --yx-ink:#e8e2d8;\n  --yx-muted:#aaa49a;\n  --yx-line:rgba(232,226,216,.11);\n  --yx-shadow:rgba(0,0,0,.22);\n}\n\n.yx-storybar::before{\n  content:\"\";\n  position:absolute;\n  top:0;\n  left:0;\n  width:68px;\n  height:3px;\n  background:currentColor;\n  opacity:.82;\n}\n\n.yx-head{\n  display:flex;\n  align-items:flex-start;\n  justify-content:space-between;\n  gap:16px;\n}\n\n.yx-chapter{\n  display:flex;\n  align-items:flex-start;\n  gap:10px;\n}\n\n.yx-number{\n  font-family:Georgia,\"Times New Roman\",serif;\n  font-size:30px;\n  line-height:.94;\n  letter-spacing:-.035em;\n  font-weight:500;\n}\n\n.yx-kicker,\n.yx-edition{\n  font-family:Georgia,\"Times New Roman\",serif;\n  font-size:8.5px;\n  line-height:1.35;\n  letter-spacing:.18em;\n  text-transform:uppercase;\n  color:var(--yx-muted);\n}\n\n.yx-kicker{padding-top:3px}\n.yx-edition{text-align:right;padding-top:1px}\n\n.yx-title{\n  margin:23px 0 7px;\n  font-family:\"Noto Serif SC\",\"Songti SC\",\"STSong\",\"SimSun\",serif;\n  font-size:27px;\n  line-height:1.18;\n  letter-spacing:.075em;\n  font-weight:600;\n}\n\n.yx-rule{\n  width:44%;\n  max-width:145px;\n  height:1px;\n  margin-bottom:16px;\n  background:currentColor;\n  opacity:.22;\n}\n\n.yx-time{\n  font-family:Georgia,\"Noto Serif SC\",\"Songti SC\",STSong,serif;\n  font-size:14px;\n  line-height:1.58;\n  letter-spacing:.025em;\n  overflow-wrap:anywhere;\n}\n\n.yx-place{\n  margin-top:8px;\n  font-family:\"Noto Serif SC\",\"Songti SC\",\"STSong\",\"SimSun\",serif;\n  font-size:12.5px;\n  line-height:1.65;\n  letter-spacing:.015em;\n  color:var(--yx-muted);\n  overflow-wrap:anywhere;\n}\n\n.yx-footer{\n  margin-top:16px;\n  padding-top:9px;\n  border-top:1px solid var(--yx-line);\n  display:flex;\n  justify-content:flex-end;\n  align-items:center;\n  gap:8px;\n}\n\n.yx-footer-line{\n  width:22px;\n  height:1px;\n  background:currentColor;\n  opacity:.28;\n}\n\n.yx-weather{\n  font-family:\"Noto Serif SC\",\"Songti SC\",\"STSong\",\"SimSun\",serif;\n  font-size:11px;\n  line-height:1.25;\n  letter-spacing:.12em;\n  color:var(--yx-muted);\n}\n\n.yx-theme-button{\n  border:0;\n  background:transparent;\n  color:var(--yx-ink);\n  padding:1px 2px;\n  margin:0;\n  cursor:pointer;\n  font-size:14px;\n  line-height:1;\n  opacity:.68;\n  user-select:none;\n  transition:opacity .18s ease, transform .18s ease;\n}\n\n.yx-theme-button:hover{opacity:1}\n.yx-theme-button:active{transform:scale(.92)}\n\n@media (max-width:360px){\n  .yx-storybar{padding:18px 17px 15px}\n  .yx-number{font-size:28px}\n  .yx-title{font-size:25px;margin-top:21px}\n}\n</style>\n\n<div class=\"yx-head\">\n  <div class=\"yx-chapter\">\n    <span class=\"yx-number\">$1</span>\n    <span class=\"yx-kicker\">CHAPTER<br>NOTE</span>\n  </div>\n  <span class=\"yx-edition\">STORY<br>EDITION</span>\n</div>\n\n<div class=\"yx-title\">$2</div>\n<div class=\"yx-rule\"></div>\n\n<div class=\"yx-time\">$3</div>\n<div class=\"yx-place\">$4</div>\n\n<div class=\"yx-footer\">\n  <span class=\"yx-footer-line\"></span>\n  <span class=\"yx-weather\">$5</span>\n  <button\n    class=\"yx-theme-button\"\n    type=\"button\"\n    title=\"切换日夜显示\" aria-label=\"切换状态栏日夜显示\" data-lantai-storybar-toggle=\"\"\n  >☾</button>\n</div>\n\n\n\n</div>",
